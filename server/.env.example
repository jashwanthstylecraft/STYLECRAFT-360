# JWT signing secret for login sessions. Set a long random value for any
# real deployment — if unset, the server generates one in memory at boot
# (fine for local dev, but every restart forces everyone to log in again).
SESSION_SECRET=

# Supabase project — snapshots/counter/users storage. The base project URL
# (NOT the /rest/v1/ REST endpoint), and the SERVICE ROLE key (trusted,
# server-only — never the anon/public key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# "Sign in with Google" (client/src/pages/Login.jsx + routes/auth.js's
# /google and /google/callback routes) — replaced the old type-any-allowed-
# email gate, since a successful Google sign-in proves the person actually
# owns that stylecraftus.com (Google Workspace) mailbox. Still gated by the
# same director allowlist (data/allowedEmails.js) after that.
# Create these at https://console.cloud.google.com -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Web application.
# Add BOTH of these as Authorized redirect URIs on that client:
#   https://stylecraft-360.vercel.app/api/auth/google/callback  (production)
#   http://localhost:4000/api/auth/google/callback              (local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI used for THIS environment — the
# production Vercel env vars should have the vercel.app URL above; a local
# server/.env should have the localhost:4000 one.
GOOGLE_REDIRECT_URI=

# Weekly Google Sheet sync — reads the team's "Data for Chart" tab directly
# via the Sheets API every Saturday (routes/cron.js's /weekly-sheet-sync,
# services/googleSheetsFetcher.js) and writes any new week straight in,
# additive-only (never touches a week that already has data). Replaced an
# earlier cloud-agent approach whose sandbox couldn't reach this app at all.
# Create a service account at https://console.cloud.google.com -> IAM &
# Admin -> Service Accounts -> Create Service Account -> Keys -> Add Key ->
# JSON (downloads a .json file). Then share the actual Google Sheet with
# that service account's email (shown on its details page, looks like
# name@project-id.iam.gserviceaccount.com) as a Viewer — read-only, it can
# never write to the sheet. Also enable the Sheets API for the project at
# https://console.cloud.google.com/apis/library/sheets.googleapis.com.
# Paste the ENTIRE downloaded JSON file as one single-line value here,
# wrapped in single quotes (its own contents use double quotes throughout,
# so double-quoting this value would conflict — see the working example
# quoting style already used for SUPABASE_SERVICE_ROLE_KEY above, but with
# ' instead of " as the outer wrapper for this one specifically).
GOOGLE_SHEETS_SERVICE_ACCOUNT_KEY=

# Excel export spawns a local Python/openpyxl child process — doesn't run on
# serverless platforms (e.g. Vercel). Default-on; set to "false" to disable
# and 503 the route instead. Pair with the client's VITE_ENABLE_EXCEL_EXPORT.
ENABLE_EXCEL_EXPORT=

# Weekly dashboard-overview email — sent automatically every Saturday by
# Vercel Cron (routes/cron.js + vercel.json's "crons" entry), and available
# for a manual/on-demand send via server/scripts/send-weekly-report.js.
# GMAIL_USER is the sending mailbox; it needs 2-Step Verification turned on
# so you can generate an App Password (Google Account -> Security -> App
# Passwords) — use that here, never the real account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Any long random string you choose — Vercel echoes it back as the
# Authorization header on every cron invocation, so routes/cron.js can tell
# a real cron fire apart from someone just hitting the URL. Only needed on
# the deployed server (Vercel), not for local manual sends.
CRON_SECRET=
# Comma-separated recipient list — leave unset to default to the login
# allowlist (data/allowedEmails.js), which is what the automated Saturday
# send always uses.
REPORT_RECIPIENTS=
# Comma-separated metric slugs to include — leave unset to use the built-in
# curated highlight set (one headline metric per department).
REPORT_METRIC_SLUGS=
