# JWT signing secret for login sessions. Set a long random value for any
# real deployment — if unset, the server generates one in memory at boot
# (fine for local dev, but every restart forces everyone to log in again).
SESSION_SECRET=

# Supabase project — snapshots/counter/users storage. The base project URL
# (NOT the /rest/v1/ REST endpoint), and the SERVICE ROLE key (trusted,
# server-only — never the anon/public key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Excel export spawns a local Python/openpyxl child process — doesn't run on
# serverless platforms (e.g. Vercel). Default-on; set to "false" to disable
# and 503 the route instead. Pair with the client's VITE_ENABLE_EXCEL_EXPORT.
ENABLE_EXCEL_EXPORT=

# Weekly dashboard-overview email (server/scripts/send-weekly-report.js).
# GMAIL_USER is the sending mailbox; it needs 2-Step Verification turned on
# so you can generate an App Password (Google Account -> Security -> App
# Passwords) — use that here, never the real account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Comma-separated recipient list.
REPORT_RECIPIENTS=
# Comma-separated metric slugs to include — leave unset to use a small
# built-in default set for now.
REPORT_METRIC_SLUGS=
